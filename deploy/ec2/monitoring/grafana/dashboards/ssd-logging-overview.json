    {
      "id": 1,
      "type": "logs",
      "title": "Request ID 추적 결과",
      "description": "상단 Request ID 변수에 Discord 알림 또는 응답 헤더의 requestId를 입력하면 해당 요청과 연결된 전체 로그를 조회합니다.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "expr": "{env=\"prod\"} | json | requestId = `$requestId` | line_format `{{if .logType}}{{.logType}}{{else}}nginx{{end}} | {{if .method}}{{.method}}{{end}} {{.uri}} | status={{if .responseStatus}}{{.responseStatus}}{{else}}{{.status}}{{end}} | result={{.result}} | action={{.action}} | ai={{.aiEndpoint}} | error={{.exceptionClass}} | msg={{.message}}`",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
