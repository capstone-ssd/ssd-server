logging {
  level = "info"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(ssd-blue|ssd-green|infra-app-1)"
    action = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "compose_service"
  }

  rule {
    target_label = "service"
    replacement = "ssd-api"
  }

  rule {
    target_label = "env"
    replacement = "prod"
  }
}

loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.docker.output
  forward_to = [loki.write.default.receiver]
}

local.file_match "nginx" {
  path_targets = [
    {__path__ = "/var/log/nginx/ssd-access.log", service = "nginx", env = "prod", log_file = "access"},
    {__path__ = "/var/log/nginx/ssd-error.log", service = "nginx", env = "prod", log_file = "error"},
    {__path__ = "/var/log/nginx/access.log", service = "nginx", env = "prod", log_file = "access"},
    {__path__ = "/var/log/nginx/error.log", service = "nginx", env = "prod", log_file = "error"},
  ]
}

loki.source.file "nginx" {
  targets = local.file_match.nginx.targets
  forward_to = [loki.write.default.receiver]
}
